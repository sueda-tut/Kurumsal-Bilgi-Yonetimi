# Docker Compose ile oluşturulacak PostgreSQL veritabanı bilgileri
POSTGRES_DB=kurumsal_bilgi
POSTGRES_USER=kurumsal_user
POSTGRES_PASSWORD=guclu_bir_veritabani_parolasi

# JWT token imzalama anahtarı
JWT_SECRET_KEY=uzun_rastgele_bir_jwt_anahtari_yazin
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=8

# OpenAI API erişim bilgileri
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-terra

# Uygulama ayarları
LOG_LEVEL=INFO
VITE_API_URL=http://127.0.0.1:8000