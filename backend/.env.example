# PostgreSQL/Supabase bağlantı adresi
DATABASE_URL=

# OpenAI API anahtarı
OPENAI_API_KEY=

# JWT token yapılandırması
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=8

# Uygulama log seviyesi
LOG_LEVEL=INFO

# RAG cevaplarının üretileceği OpenAI modeli
OPENAI_CHAT_MODEL=gpt-5.6-terra